# Gmail sender identity
SENDER_EMAIL=pmb@itts.ac.id
SENDER_NAME=PMB Institut Teknologi Tangerang Selatan
REPLY_TO_EMAIL=pmb@itts.ac.id
UNSUBSCRIBE_EMAIL=pmb@itts.ac.id

# Google authentication mode: oauth2 OR service_account
GOOGLE_AUTH_MODE=oauth2

# OAuth2 (recommended for a normal Gmail / Google Workspace mailbox)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Service account (Google Workspace + Domain-Wide Delegation required)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials.json
# Alternative: put the entire JSON credential in this environment variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
GMAIL_IMPERSONATED_USER=pmb@itts.ac.id

# Campaign content
EMAIL_SUBJECT=PMB ITTS 2026 Masih Dibuka — Lanjutkan Langkahmu Bersama ITTS
PMB_DEADLINE=30 September 2026
PROMO_CODE=ITTS08
PROMO_DISCOUNT=Rp2.000.000
REGISTRATION_URL=https://registrasi.itts.ac.id
PMB_WHATSAPP=6287772771775

# Sending safety
# Keep true until preview + test email have been checked.
DRY_RUN=true
SEND_DELAY_MS=1500
SUPPRESSION_FILE=./data/suppression-list.csv
SENT_LOG_FILE=./logs/sent.jsonl
